{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2023",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noEmitOnError": false,
    "rootDir": "..",
    "outDir": "../.check",
    "types": ["node"]
  },
  "include": ["../src/**/*.ts", "./**/*.ts"]
}
