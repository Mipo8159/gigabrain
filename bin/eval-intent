#!/usr/bin/env python3
"""Eval for the intent-reviewer agent (and a baseline agent, default `reviewer`).

Each case in evals/intent-review/cases/<case>/ is: spec.md (the requirement),
change/ (files overlaid on evals/intent-review/base) or commits/<n>/ + messages
(a multi-commit range), mode (range|worktree|audit),
expect.json ({"kind":"gap","gap":...} or {"kind":"control"}; "plan": true also requires a fix plan).
mode audit: change/ is committed as the submission and the agent audits the whole tree at HEAD
(no diff); a change/SUBMISSION.md is passed as the claims file.
For every case x agent: build a temp git repo, run `claude -p --agent <agent>`,
then grade. A gap case passes when a judge model says the report names the
planted gap; a control case passes when the report raises no blocker. For
intent-reviewer the VERDICT line must also match (broken/at-risk vs intact).

An agent suffixed `:nospec` gets no requirement and no memory (today's habit: review the diff alone).
Nothing an agent can read may name the case or the planted gap (paths, commit messages, comments).
A case may ship memory/ (e.g. business-invariants.md); every agent gets it as "Memory dir".

Usage: bin/eval-intent [--agents intent-reviewer,reviewer,reviewer:nospec] [--cases a-,b-] [--runs N] [--out DIR]
Costs real model calls (cases x agents x runs agent calls, plus as many judge calls). Temp dirs only.
"""
import argparse, concurrent.futures as cf, json, os, re, shutil, subprocess, sys, tempfile, time
from pathlib import Path

G = Path(__file__).resolve().parent.parent
E = G / "evals" / "intent-review"
TIMEOUT = 900
# Child sessions must not feed Giga's coach signals or get coach cues injected.
ENV = {**os.environ, "GIGABRAIN_HARVEST": "1", "GIGABRAIN_NO_SIGNALS": "1"}


def sh(cmd, cwd):
    subprocess.run(cmd, cwd=cwd, check=True, capture_output=True, text=True)


def build_repo(case: Path, root: Path) -> Path:
    repo = root / "repo"
    shutil.copytree(E / "base", repo)
    sh(["git", "init", "-q", "-b", "main"], repo)
    sh(["git", "add", "-A"], repo)
    sh(["git", "-c", "user.name=Base", "-c", "user.email=base@example.com", "commit", "-qm", "content platform baseline"], repo)
    if (case / "commits").is_dir():  # multi-commit range: commits/1, 2, ... + one message per line
        msgs = (case / "messages").read_text().splitlines()
        for i, d in enumerate(sorted((case / "commits").iterdir(), key=lambda p: int(p.name))):
            shutil.copytree(d, repo, dirs_exist_ok=True)
            sh(["git", "add", "-A"], repo)
            sh(["git", "-c", "user.name=Teammate", "-c", "user.email=mate@example.com", "commit", "-qm", msgs[i]], repo)
        return repo
    shutil.copytree(case / "change", repo, dirs_exist_ok=True)
    if mode_of(case) in ("range", "audit"):
        sh(["git", "add", "-A"], repo)
        sh(["git", "-c", "user.name=Teammate", "-c", "user.email=mate@example.com", "commit", "-qm",
            "submission" if mode_of(case) == "audit" else (case / "spec.md").read_text().splitlines()[0].lstrip("# ")], repo)
    return repo


def mode_of(case: Path) -> str:
    return (case / "mode").read_text().strip()


def target_of(case: Path) -> str:
    if mode_of(case) == "audit":
        return "audit: the whole codebase at HEAD (no diff)"
    n = len(list((case / "commits").iterdir())) if (case / "commits").is_dir() else 1
    return (f"commit range HEAD~{n}..HEAD (a teammate's commit{'s' if n > 1 else ''})"
            if mode_of(case) == "range" else "the working tree (git diff HEAD + untracked)")


def run_agent(agent: str, case: Path, run: int, out: Path) -> dict:
    root = Path(tempfile.mkdtemp(prefix="rv-"))  # neutral: the path must not leak the case name
    t, error = time.time(), None
    try:
        repo = build_repo(case, root)
        spec = root / "spec.md"  # outside the repo so it isn't part of the diff
        shutil.copy(case / "spec.md", spec)
        mem = "none"
        name, _, variant = agent.partition(":")
        if (case / "memory").is_dir() and variant != "nospec":
            shutil.copytree(case / "memory", root / "memory")
            mem = str(root / "memory")
        req = ("Requirement: none provided; review the change as you normally would.\n" if variant == "nospec"
               else f"Requirement: {spec}\n")
        audit = mode_of(case) == "audit"
        claims = (f"Claims: {repo / 'SUBMISSION.md'}\n" if audit and (repo / "SUBMISSION.md").exists() else "")
        prompt = (("Audit this codebase against the requirement.\n" if audit else "Review this change.\n") + f"{req}{claims}"
                  f"Target: {target_of(case)} in {repo}\nMemory dir: {mem}\n"
                  "Do not ask questions; this is non-interactive. Report your findings.")
        t = time.time()
        p = subprocess.run(["claude", "-p", "--agent", name, "--allowedTools", "Read,Grep,Glob,Bash",
                            "--output-format", "text", prompt],
                           cwd=repo, capture_output=True, text=True, timeout=TIMEOUT, env=ENV)
        report = p.stdout.strip()
        if p.returncode != 0 or not report or "hit your session limit" in report:
            error = f"rc={p.returncode} {(report or p.stderr)[-300:]}"
    except Exception as e:  # timeout, missing claude, fixture build failure
        report, error = "", f"{type(e).__name__}: {e}"
    finally:
        shutil.rmtree(root, ignore_errors=True)
    f = out / f"{case.name}.{agent.replace(':', '-')}.{run}.md"
    f.write_text(report or f"(ERROR) {error}")
    return {"case": case.name, "agent": agent, "run": run, "report": report, "error": error,
            "file": str(f), "secs": int(time.time() - t)}


def judge(question: str, report: str) -> bool:
    """YES/NO from a judge model; raises when the judge fails, so a broken judge is never a pass."""
    prompt = (f"{question}\nAnswer with exactly one word, YES or NO.\n\n<report>\n{report[:30000]}\n</report>")
    p = subprocess.run(["claude", "-p", "--model", "sonnet", "--output-format", "text", prompt],
                       capture_output=True, text=True, timeout=300, cwd=tempfile.gettempdir(), env=ENV)
    m = re.match(r"^\W*(YES|NO)\b", p.stdout.strip(), re.I)
    if p.returncode != 0 or not m:
        raise RuntimeError(f"judge failed: rc={p.returncode} {p.stdout[-200:]!r}")
    return m.group(1).upper() == "YES"


def grade(r: dict, case: Path) -> dict:
    if r["error"]:
        return {**r, "verdict": None, "pass": False, "why": f"ERROR {r['error'][:120]}"}
    try:
        return _grade(r, case)
    except Exception as e:
        return {**r, "verdict": None, "pass": False, "why": f"ERROR {e}"[:140]}


def _grade(r: dict, case: Path) -> dict:
    exp = json.loads((case / "expect.json").read_text())
    m = re.search(r"VERDICT\W*([a-z-]+)", r["report"], re.I)
    verdict = m.group(1).lower() if m else None
    strict = r["agent"].partition(":")[0] == "intent-reviewer"  # only it promises a VERDICT line
    if exp["kind"] == "gap":
        found = judge("Does this code-review report identify the following problem as a finding of "
                      f"blocker or should-fix severity (or equivalent wording)? Problem: {exp['gap']}", r["report"])
        ok = found and (not strict or verdict in ("broken", "at-risk"))
        why = f"gap {'named' if found else 'MISSED'}"
        if ok and strict and exp.get("plan"):
            ok = judge("Does this report include a fix plan that, for each gap it found, gives an approach and a "
                       "test that would prove the fix, without claiming to have already fixed anything?", r["report"])
            why += ", plan ok" if ok else ", NO PLAN"
    else:
        blocker = judge("Does this code-review report raise any blocker-severity finding, or claim that a "
                        "requirement of the reviewed change is missing, contradicted or not implemented? "
                        "Pre-existing issues explicitly marked as outside the change's scope do not count.",
                        r["report"])
        ok = (not blocker) and (not strict or verdict == "intact")
        why = "no blocker" if not blocker else "FALSE BLOCKER"
    return {**r, "verdict": verdict, "pass": ok, "why": why}


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--agents", default="intent-reviewer,reviewer")
    ap.add_argument("--cases", default="", help="comma-separated name prefixes")
    ap.add_argument("--runs", type=int, default=1)
    ap.add_argument("--out", default="")
    a = ap.parse_args()
    cases = sorted(c for c in (E / "cases").iterdir() if c.is_dir()
                   and (not a.cases or any(c.name.startswith(p) for p in a.cases.split(","))))
    if not cases:
        sys.exit(f"no cases match --cases {a.cases!r}")
    # Reports stay out of /tmp, where agents running in parallel (with Bash) could read them.
    out = Path(a.out) if a.out else E / ".out" / time.strftime("%Y%m%d-%H%M%S")
    out.mkdir(parents=True, exist_ok=True)
    jobs = [(ag, c, n) for ag in a.agents.split(",") for c in cases for n in range(1, a.runs + 1)]
    print(f"{len(jobs)} runs → reports in {out}", flush=True)
    by = {c.name: c for c in cases}
    results = []
    with cf.ThreadPoolExecutor(max_workers=8) as ex:
        for r in cf.as_completed([ex.submit(run_agent, *j, out) for j in jobs]):
            g = grade(r.result(), by[r.result()["case"]])
            if re.search(r"expect\.json|evals/intent-review|\.out/", g["report"]):
                g = {**g, "pass": False, "why": "LEAK: report references the eval's own files"}
            results.append(g)
            (out / "results.json").write_text(json.dumps([{k: v for k, v in x.items() if k != "report"} for x in results], indent=1))
            print(f"  {'PASS' if g['pass'] else 'FAIL'}  {g['agent']:<16} {g['case']:<32} run{g['run']} "
                  f"verdict={g['verdict']} {g['why']} ({g['secs']}s)", flush=True)
    print("\nscore:")
    for ag in a.agents.split(","):
        rs = [r for r in results if r["agent"] == ag]
        print(f"  {ag:<16} {sum(r['pass'] for r in rs)}/{len(rs)}")
    first = a.agents.split(",")[0]
    sys.exit(0 if all(r["pass"] for r in results if r["agent"] == first) else 1)


if __name__ == "__main__":
    main()
